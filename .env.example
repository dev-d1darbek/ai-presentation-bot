# Telegram Bot Token (@BotFather арқылы алынады)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRstuVWXyz

# Бот әкімшісінің Telegram ID-і (/admin статистикасына және /give командасына қол жеткізу үшін)
ADMIN_IDS=123456789

# Админмен тікелей байланыс (@username)
ADMIN_CONTACT=@your_telegram_username

# Kaspi Pay Фискалдық Чек Тексеру (verifier.py) баптаулары
KASPI_PAY_URL=https://pay.kaspi.kz/pay/YOUR_KASPI_LINK
KASPI_BIN=000000000000
KASPI_PHONE=+7 777 000 00 00
KASPI_RECIPIENT_NAME=Дидарбек А.

# Реферал табысын шығарудың минималды сомасы (₸)
MIN_WITHDRAWAL_KZT=2000

# Жаңа пайдаланушыға тіркелгенде берілетін тегін презентация саны (Фотосыз)
WELCOME_FREE_CREDITS=1

# AI Кілті (DeepSeek, Gemini, OpenAI - мәтін және gpt-image-2 Low сурет генерациясы үшін)
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Масштабтау: PostgreSQL және Redis (қосымша, бос болса SQLite WAL + In-Memory қолданылады)
DATABASE_URL=
REDIS_URL=

# Өнім аналитикасы (Mixpanel / PostHog — қосымша)
MIXPANEL_TOKEN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# Әдепкі баптаулар
DEFAULT_SLIDE_COUNT=15
DEFAULT_THEME_ID=swiss_minimalism

# Өндірісте 0 болуы тиіс (тек тест үшін 1)
DEBUG=0
