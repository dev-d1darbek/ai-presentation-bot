# Telegram Bot Token (@BotFather арқылы алынады)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRstuVWXyz

# Бот әкімшісінің Telegram ID-і (/admin статистикасына қол жеткізу үшін)
# Өз ID-іңізді @userinfobot немесе @myidbot арқылы білуге болады
ADMIN_IDS=123456789

# AI Кілті (DeepSeek немесе Gemini немесе OpenAI - кез келген біреуі жеткілікті)
# Ешқандай кілт енгізілмесе де бот толықтай қазақша Intelligent Fallback арқылы жұмыс істей береді!
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Әдепкі баптаулар
DEFAULT_SLIDE_COUNT=15
DEFAULT_THEME_ID=swiss_minimalism
